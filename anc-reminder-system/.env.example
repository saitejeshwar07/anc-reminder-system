# ---- Server ----
PORT=3000
# Public HTTPS address Twilio can reach (ngrok URL while testing, your domain in production)
PUBLIC_BASE_URL=https://your-public-url.example.com

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ---- Admin login (recommended). Leave empty only on a closed local machine. ----
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- Reminder rules ----
APP_TIMEZONE=Asia/Kolkata
# Calls are only placed between these hours (24h clock, hospital time)
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=18
# A call counts as "listened" if it lasted at least this many seconds
MIN_ANSWER_SECONDS=10

# ---- Testing ----
# true = place no real calls; use the "She answered / No answer" buttons in the admin panel
DRY_RUN=false
